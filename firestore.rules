rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Projects collection
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Milestones collection
    match /milestones/{milestoneId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Contact messages: anyone can create (send a message), only authenticated admins can read/update/delete
    match /messages/{messageId} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.email is string
                    && request.resource.data.message is string;
      allow read, update, delete: if request.auth != null;
    }

    // Analytics: anyone can log anonymous page views, only authenticated admins can read/delete
    match /analytics/{eventId} {
      allow create: if request.resource.data.type is string 
                    && request.resource.data.path is string;
      allow read, delete: if request.auth != null;
    }

    // Site settings: anyone can read, only authenticated admins can write
    match /siteConfig/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Survey responses: anyone can submit anonymous answers without PII, only authenticated admins can read/delete
    match /surveyResponses/{responseId} {
      allow create: if request.resource.data.q1_interest is string
                    && request.resource.data.q2_online_reading is string
                    && request.resource.data.q3_continue_learning is string
                    && request.resource.data.submittedAt is string;
      allow read, delete: if request.auth != null;
    }

    // Learning resources: public read, admin write, public can increment view/download stats
    match /learningResources/{resourceId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'downloadCount']));

      // Chunks for large files (PDFs, courses, ebooks, archives)
      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
